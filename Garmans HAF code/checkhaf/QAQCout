+ 
+ 	## Declutter and save space
+         remove(store.df)
+         remove(retain)
+         remove(xcel)
+         remove(xcelIN)
+         remove(path.nam)
+ 
+ 
+ 	## Return the modified pts file(s) contained in the named list
+         return(pts)
+ 
+ } ## end of function
